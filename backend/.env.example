# ------------------------------------------------------------------------------
# MEDICONNECT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' inside the 'backend' folder and fill in the values.
# ------------------------------------------------------------------------------

# App Environment Configuration
PORT=5000
NODE_ENV=development # Options: development, production, test

# JSON Web Token Secret (Required for session authentication signing)
JWT_SECRET=your_super_secure_jwt_signing_secret_key

# Centralized PostgreSQL Connection Pool Configuration
# Option A: Connection string (recommended for cloud/production like Supabase, Render DB, Neon)
DATABASE_URL=postgresql://postgres:password@localhost:5432/mediconnect

# Option B: Individual PostgreSQL parameters (fallback if DATABASE_URL is not provided)
PGHOST=localhost
PGPORT=5432
PGDATABASE=mediconnect
PGUSER=postgres
PGPASSWORD=your_postgres_password

# Connection Pool Tuning Parameters
PGMAXPOOL=10
PGIDLETIMEOUT=30000
PGCONNECTTIMEOUT=2000

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# Set this variable in your deployment platform or in a frontend/.env file
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000